/* Gitory Light Theme
 * Clean, professional light theme.
 */

* {
    font-family: "Segoe UI", "Inter", "Roboto", sans-serif;
    font-size: 10pt;
}

QMainWindow {
    background-color: #f5f5f7;
    color: #1d1d1f;
}

QWidget {
    background-color: #f5f5f7;
    color: #1d1d1f;
    border: none;
}

QToolBar {
    background-color: #ffffff;
    border-bottom: 1px solid #d1d1d6;
    padding: 4px 8px;
    spacing: 4px;
}

QToolBar::separator {
    background-color: #d1d1d6;
    width: 1px;
    margin: 4px 8px;
}

QToolButton {
    background-color: transparent;
    color: #636366;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 6px 10px;
    margin: 2px;
    font-size: 9pt;
}

QToolButton:hover {
    background-color: #e8e8ed;
    color: #1d1d1f;
    border: 1px solid #d1d1d6;
}

QToolButton:pressed {
    background-color: #d1d1d6;
    color: #0066cc;
}

QTreeWidget, QTreeView {
    background-color: #f5f5f7;
    color: #1d1d1f;
    border: none;
    padding: 4px;
}

QTreeWidget::item, QTreeView::item {
    padding: 5px 8px;
    border-radius: 4px;
    margin: 1px 4px;
}

QTreeWidget::item:hover {
    background-color: #e8e8ed;
}

QTreeWidget::item:selected {
    background-color: #0066cc;
    color: #ffffff;
}

QSplitter::handle {
    background-color: #d1d1d6;
}

QSplitter::handle:horizontal { width: 2px; }
QSplitter::handle:vertical { height: 2px; }
QSplitter::handle:hover { background-color: #0066cc; }

QScrollBar:vertical {
    background-color: transparent;
    width: 10px;
}

QScrollBar::handle:vertical {
    background-color: #c7c7cc;
    border-radius: 5px;
    min-height: 30px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background-color: #a1a1a6;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    height: 0; background: none;
}

QScrollBar:horizontal {
    background-color: transparent;
    height: 10px;
}

QScrollBar::handle:horizontal {
    background-color: #c7c7cc;
    border-radius: 5px;
    min-width: 30px;
    margin: 2px;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    width: 0; background: none;
}

QPushButton {
    background-color: #ffffff;
    color: #1d1d1f;
    border: 1px solid #d1d1d6;
    border-radius: 6px;
    padding: 8px 16px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #e8e8ed;
    border-color: #a1a1a6;
}

QPushButton:pressed {
    background-color: #d1d1d6;
}

QPushButton#primaryButton {
    background-color: #0066cc;
    color: #ffffff;
    border: none;
    font-weight: bold;
}

QPushButton#primaryButton:hover {
    background-color: #0077ed;
}

QPushButton#dangerButton {
    background-color: #ff3b30;
    color: #ffffff;
    border: none;
}

QLineEdit {
    background-color: #ffffff;
    color: #1d1d1f;
    border: 1px solid #d1d1d6;
    border-radius: 6px;
    padding: 8px 12px;
    selection-background-color: #0066cc;
    selection-color: #ffffff;
}

QLineEdit:focus { border-color: #0066cc; }

QPlainTextEdit, QTextEdit {
    background-color: #ffffff;
    color: #1d1d1f;
    border: 1px solid #d1d1d6;
    border-radius: 6px;
    padding: 8px;
    font-family: "Cascadia Code", "Consolas", "Fira Code", monospace;
    font-size: 10pt;
}

QLabel { background-color: transparent; color: #1d1d1f; }
QLabel#sectionHeader { color: #636366; font-size: 9pt; font-weight: bold; }

QTabBar::tab {
    background-color: #ffffff;
    color: #636366;
    border: none;
    padding: 10px 20px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}

QTabBar::tab:selected {
    color: #0066cc;
    border-bottom: 2px solid #0066cc;
}

QCheckBox { background-color: transparent; spacing: 8px; padding: 4px; }
QCheckBox::indicator {
    width: 18px; height: 18px;
    border: 2px solid #d1d1d6; border-radius: 4px;
    background-color: #ffffff;
}
QCheckBox::indicator:checked {
    background-color: #0066cc; border-color: #0066cc;
}

QDialog { background-color: #f5f5f7; }

QGroupBox {
    background-color: #ffffff;
    border: 1px solid #d1d1d6;
    border-radius: 8px;
    margin-top: 16px;
    padding: 16px 12px 12px 12px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 4px 12px;
    color: #0066cc;
}

QToolTip {
    background-color: #ffffff;
    color: #1d1d1f;
    border: 1px solid #d1d1d6;
    border-radius: 6px;
    padding: 8px 12px;
}

QStatusBar {
    background-color: #ffffff;
    color: #636366;
    border-top: 1px solid #d1d1d6;
}
